
import numpy as np

# Input dataset (XOR)
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

Y = np.array([
    [0],
    [1],
    [1],
    [0]
])

# Sigmoid activation function
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

# Initialize weights
np.random.seed(42)

W1 = np.random.rand(2, 4)
W2 = np.random.rand(4, 1)

b1 = np.zeros((1, 4))
b2 = np.zeros((1, 1))

learning_rate = 0.5

# Training using backpropagation
for epoch in range(10000):

    # Forward propagation
    hidden = sigmoid(np.dot(X, W1) + b1)
    output = sigmoid(np.dot(hidden, W2) + b2)

    # Backpropagation
    error = output - Y

    d_output = error * output * (1 - output)
    d_hidden = np.dot(d_output, W2.T) * hidden * (1 - hidden)

    # Update weights and biases
    W2 -= learning_rate * np.dot(hidden.T, d_output) / len(X)
    b2 -= learning_rate * np.mean(d_output, axis=0, keepdims=True)

    W1 -= learning_rate * np.dot(X.T, d_hidden) / len(X)
    b1 -= learning_rate * np.mean(d_hidden, axis=0, keepdims=True)

# Testing
print("ANN using Backpropagation")
print("Input    Target    Predicted")

for i in range(len(X)):
    hidden = sigmoid(np.dot(X[i:i+1], W1) + b1)
    output = sigmoid(np.dot(hidden, W2) + b2)

    prediction = 1 if output[0][0] >= 0.5 else 0

    print(X[i], "    ", Y[i][0], "       ", prediction)
