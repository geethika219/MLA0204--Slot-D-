import numpy as np
import matplotlib.pyplot as plt
from sklearn.mixture import GaussianMixture

# Generate sample data
np.random.seed(42)

X1 = np.random.normal(2, 1, (100, 2))
X2 = np.random.normal(7, 1, (100, 2))

X = np.vstack((X1, X2))

# Apply EM Algorithm
model = GaussianMixture(n_components=2, random_state=42)
model.fit(X)

# Predict clusters
labels = model.predict(X)

print("Cluster Means:")
print(model.means_)

print("Cluster Labels:")
print(labels)

# Plot clusters
plt.scatter(X[:, 0], X[:, 1], c=labels, cmap='viridis')
plt.scatter(
    model.means_[:, 0],
    model.means_[:, 1],
    color='red',
    marker='X',
    s=200
)
plt.title("Expectation Maximization Algorithm")
plt.show()
