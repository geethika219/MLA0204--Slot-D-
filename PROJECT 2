
# Candidate Elimination Algorithm

data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

n = len(data[0]) - 1

S = ['0'] * n
G = [['?'] * n]

for example in data:
    x = example[:-1]
    label = example[-1]

    if label == 'Yes':
        G = [g for g in G if all(
            a == '?' or a == b for a, b in zip(g, x)
        )]

        for i in range(n):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'

    else:
        new_G = []

        for g in G:
            for i in range(n):
                if g[i] == '?':
                    if S[i] != '?' and S[i] != '0' and S[i] != x[i]:
                        new_h = g.copy()
                        new_h[i] = S[i]
                        new_G.append(new_h)

        G = new_G

print("Specific Boundary (S):")
print(S)

print("General Boundary (G):")
for g in G:
    print(g)
